# Образец для docker-compose.yml. Скопируйте в .env и заполните.
# Сгенерировать секреты:  python -c "import secrets; print(secrets.token_urlsafe(48))"

ENV=production
PROJECT_NAME=AniFlow API

SECRET_KEY=
POSTGRES_USER=aniflow
POSTGRES_PASSWORD=
POSTGRES_DB=aniflow
REDIS_PASSWORD=

# Адрес сайта (тот же origin, что отдаёт frontend-nginx)
BACKEND_CORS_ORIGINS=https://your-domain.example

# Необязательно
SENTRY_DSN=
VITE_SENTRY_DSN=
METRICS_TOKEN=
HTTP_PORT=8080
