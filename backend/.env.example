# Локальный запуск бэкенда без Docker (uvicorn app.main:app --reload).
# Скопируйте в backend/.env. В production переменные задаёт docker-compose.

ENV=development
PROJECT_NAME=AniFlow API

# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

DATABASE_URL=postgresql+asyncpg://aniflow:CHANGE_ME@localhost:5432/aniflow
REDIS_URL=redis://localhost:6379/0

# Через запятую или JSON-массивом
BACKEND_CORS_ORIGINS=http://localhost:5173

# Мониторинг (необязательно). Переменная называется именно SENTRY_DSN.
SENTRY_DSN=
METRICS_TOKEN=
